{
  "name": "SAOS Pipeline Tracker Sync",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "saos-pipeline-sync",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b2c3d4e5-0001-4000-8000-000000000001",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parse incoming email event payload\n// Expected fields: event_type, prospect_email, prospect_name, company, timestamp\n\nconst body = $input.first().json;\n\nconst eventType = body.event_type || body.type || 'unknown';\nconst prospectEmail = body.prospect_email || body.email || body.recipient || '';\nconst prospectName = body.prospect_name || body.name || '';\nconst company = body.company || body.company_name || '';\nconst timestamp = body.timestamp || new Date().toISOString();\nconst linkClicked = body.link || body.url || '';\nconst replyContent = body.reply_body || body.text || '';\n\n// Map event types to pipeline stages\nconst stageMap = {\n  'email_open': 'Outreach Sent',\n  'email_click': 'Outreach Sent',\n  'email_reply': 'Discovery Scheduled',\n  'email_bounce': 'Closed Lost',\n  'email_unsubscribe': 'Closed Lost'\n};\n\nconst newStage = stageMap[eventType] || 'Outreach Sent';\n\nreturn [{\n  json: {\n    event_type: eventType,\n    prospect_email: prospectEmail,\n    prospect_name: prospectName,\n    company: company,\n    timestamp: timestamp,\n    new_stage: newStage,\n    link_clicked: linkClicked,\n    reply_content: replyContent,\n    is_reply: eventType === 'email_reply',\n    is_bounce: eventType === 'email_bounce',\n    is_open: eventType === 'email_open',\n    is_click: eventType === 'email_click'\n  }\n}];"
      },
      "id": "b2c3d4e5-0001-4000-8000-000000000002",
      "name": "Parse Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.event_type }}",
        "rules": {
          "rules": [
            {
              "value2": "email_reply",
              "outputKey": "reply"
            },
            {
              "value2": "email_open",
              "outputKey": "open"
            },
            {
              "value2": "email_click",
              "outputKey": "click"
            },
            {
              "value2": "email_bounce",
              "outputKey": "bounce"
            },
            {
              "value2": "email_unsubscribe",
              "outputKey": "unsubscribe"
            }
          ]
        },
        "fallbackOutput": 5
      },
      "id": "b2c3d4e5-0001-4000-8000-000000000003",
      "name": "Event Type Switch",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://portal.systack.net/api/v1/sales/pipeline-update",
        "sendBody": true,
        "bodyParameters": "{\"prospect_email\":\"{{ $json.prospect_email }}\",\"prospect_name\":\"{{ $json.prospect_name }}\",\"company\":\"{{ $json.company }}\",\"stage\":\"{{ $json.new_stage }}\",\"event_type\":\"{{ $json.event_type }}\",\"timestamp\":\"{{ $json.timestamp }}\"}",
        "options": {}
      },
      "id": "b2c3d4e5-0001-4000-8000-000000000004",
      "name": "Update Tracker (Reply)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [750, 0]
    },
    {
      "parameters": {
        "sendTo": "green@systack.net",
        "subject": "🎉 Prospect Replied: {{ $json.prospect_name }} at {{ $json.company }}",
        "message": "A prospect just replied to your cold email!\n\nName: {{ $json.prospect_name }}\nCompany: {{ $json.company }}\nEmail: {{ $json.prospect_email }}\nReply: {{ $json.reply_content }}\n\nCheck your inbox and respond within 24 hours.\n\n— SAOS Pipeline Sync",
        "options": {}
      },
      "id": "b2c3d4e5-0001-4000-8000-000000000005",
      "name": "Notify Green (Reply)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1000, 0],
      "credentials": {
        "gmail": {
          "id": "gmail_saos_outreach",
          "name": "Gmail - SAOS Outreach"
        }
      }
    },
