{
  "name": "SAOS Email Notification Dispatcher",
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "e1b2c3d4-0001-4000-8000-000000000001",
      "name": "Schedule: Every 60s",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 60
            }
          ]
        }
      }
    },
    {
      "id": "e1b2c3d4-0001-4000-8000-000000000002",
      "name": "HTTP: Fetch Pending Notifications",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "http://localhost:8768/api/internal/notifications/pending",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Api-Key",
              "value": "={{$env.SAOS_INTERNAL_API_KEY}}"
            }
          ]
        },
        "options": {
          "retry": {
            "enabled": true,
            "attempts": 5,
            "wait": 30000,
            "continueOnFail": false
          }
        }
      }
    },
    {
      "id": "e1b2c3d4-0001-4000-8000-000000000003",
      "name": "Split Out: One Per Notification",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      }
    },
    {
      "id": "e1b2c3d4-0001-4000-8000-000000000004",
      "name": "IF: Has Email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-has-email",
              "leftValue": "={{$json.email}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "e1b2c3d4-0001-4000-8000-000000000005",
      "name": "Email: Send Notification",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "fromEmail": "phillip@systack.net",
        "toEmail": "={{$json.email}}",
        "subject": "={{$json.subject || 'SAOS Notification'}}",
        "emailFormat": "html",
        "html": "={{'<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;\"><div style=\"background:#1a1a2e;color:#fff;padding:20px;border-radius:8px 8px 0 0;\"><h2 style=\"margin:0;\">SAOS Notification</h2></div><div style=\"padding:20px;border:1px solid #ddd;border-top:none;border-radius:0 0 8px 8px;\"><p>' + ($json.message || $json.body || 'You have a new notification.') + '</p></div><p style=\"color:#888;font-size:12px;text-align:center;\">SAOS Platform \u2014 Automated Notification</p></div>'}}",
        "options": {
          "host": "smtp.gmail.com",
          "port": 587,
          "user": "phillip@systack.net",
          "password": "={{$env.SMTP_PASSWORD}}"
        }
      }
    },
    {
      "id": "e1b2c3d4-0001-4000-8000-000000000006",
      "name": "HTTP: BlueBubbles Fallback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        880,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BLUEBUBBLES_URL}}/api/send",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { recipient: $json.recipient || '+15012746231', message: $json.message || $json.body || 'SAOS Notification' } }}",
        "options": {
          "retry": {
            "enabled": true,
            "attempts": 5,
            "wait": 30000,
            "continueOnFail": false
          }
        }
      }
    },
    {
      "id": "e1b2c3d4-0001-4000-8000-000000000007",
      "name": "HTTP: Mark as Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "method": "PUT",
        "url": "={{'http://localhost:8768/api/internal/notifications/' + $json.id + '/sent'}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { status: 'sent' } }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Api-Key",
              "value": "={{$env.SAOS_INTERNAL_API_KEY}}"
            }
          ]
        },
        "options": {
          "retry": {
            "enabled": true,
            "attempts": 5,
            "wait": 30000,
            "continueOnFail": false
          }
        }
      }
    },
    {
      "id": "e1b2c3d4-0001-4000-8000-000000000008",
      "name": "Code: Failure Logger",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst failed = items.filter(i => i.json.error || i.json.error_message);\nreturn failed.length > 0 ? [{ json: { success: false, failed_count: failed.length, notification_ids: failed.map(f => f.json.id), timestamp: new Date().toISOString() } }] : [{ json: { success: true, failed_count: 0, timestamp: new Date().toISOString() } }];"
      }
    }
  ],
  "connections": {
    "Schedule: Every 60s": {
      "main": [
        [
          {
            "node": "HTTP: Fetch Pending Notifications",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP: Fetch Pending Notifications": {
      "main": [
        [
          {
            "node": "Split Out: One Per Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Out: One Per Notification": {
      "main": [
        [
          {
            "node": "IF: Has Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF: Has Email": {
      "main": [
        [
          {
            "node": "Email: Send Notification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "HTTP: BlueBubbles Fallback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email: Send Notification": {
      "main": [
        [
          {
            "node": "HTTP: Mark as Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP: BlueBubbles Fallback": {
      "main": [
        [
          {
            "node": "HTTP: Mark as Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP: Mark as Sent": {
      "main": [
        [
          {
            "node": "Code: Failure Logger",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}