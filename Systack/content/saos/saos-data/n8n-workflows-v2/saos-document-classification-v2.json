{
  "name": "SAOS Document Classification Engine",
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "c1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook: Doc Uploaded",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "saos-doc-uploaded",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "saos-doc-uploaded-v2"
    },
    {
      "id": "c1b2c3d4-0001-4000-8000-000000000002",
      "name": "Code: Classify Document",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const payload = $input.first().json.body || $input.first().json;\nconst filename = (payload.filename || '').toLowerCase();\nconst mimeType = payload.mime_type || '';\nconst allowedMimes = ['application/pdf', 'image/png', 'image/jpeg', 'image/jpg', 'text/plain', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'application/vnd.ms-excel', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'];\nconst mimeValid = allowedMimes.includes(mimeType);\nlet classification = 'other';\nif (/invoice|inv_|bill|receipt/.test(filename)) {\n  classification = 'invoice';\n} else if (/contract|agreement|msa|sow/.test(filename)) {\n  classification = 'contract';\n} else if (/form|application|intake/.test(filename)) {\n  classification = 'form';\n}\nreturn [{ json: { ...payload, classification, mimeValid } }];"
      }
    },
    {
      "id": "c1b2c3d4-0001-4000-8000-000000000003",
      "name": "IF: Is Invoice",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-is-invoice",
              "leftValue": "={{$json.classification}}",
              "rightValue": "invoice",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "c1b2c3d4-0001-4000-8000-000000000004",
      "name": "HTTP: Send to Invoice Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        660,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8768/api/notifications",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { client_id: $json.client_id, type: 'invoice_classified', message: 'Invoice document classified: ' + ($json.filename || 'unknown'), urgency: 'normal', channel: 'dashboard' } }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Api-Key",
              "value": "={{$env.SAOS_INTERNAL_API_KEY}}"
            }
          ]
        },
        "options": {
          "retry": {
            "enabled": true,
            "attempts": 5,
            "wait": 30000,
            "continueOnFail": false
          }
        }
      }
    },
    {
      "id": "c1b2c3d4-0001-4000-8000-000000000005",
      "name": "IF: Is Contract or Form",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        400
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-is-contract",
              "leftValue": "={{$json.classification}}",
              "rightValue": "contract",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "cond-is-form",
              "leftValue": "={{$json.classification}}",
              "rightValue": "form",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      }
    },
    {
      "id": "c1b2c3d4-0001-4000-8000-000000000006",
      "name": "Postgres: Legal Review Task",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        880,
        300
      ],
      "parameters": {
        "credentialId": "postgres_saos",
        "database": "systack_memory",
        "schema": "public",
        "operation": "executeQuery",
        "query": "INSERT INTO task_queue (type, status, payload, created_at) VALUES ('legal_review', 'pending', $1::jsonb, NOW())",
        "queryParameters": "={{[JSON.stringify($json)]}}"
      }
    },
    {
      "id": "c1b2c3d4-0001-4000-8000-000000000007",
      "name": "Postgres: General Task",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        880,
        500
      ],
      "parameters": {
        "credentialId": "postgres_saos",
        "database": "systack_memory",
        "schema": "public",
        "operation": "executeQuery",
        "query": "INSERT INTO task_queue (type, status, payload, created_at) VALUES ('general', 'pending', $1::jsonb, NOW())",
        "queryParameters": "={{[JSON.stringify($json)]}}"
      }
    },
    {
      "id": "c1b2c3d4-0001-4000-8000-000000000008",
      "name": "HTTP: Notify Classification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1100,
        400
      ],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8768/api/notifications",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { message: 'Document classified: ' + ($('Code: Classify Document').first().json.classification || 'unknown') } }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Api-Key",
              "value": "={{$env.SAOS_INTERNAL_API_KEY}}"
            }
          ]
        },
        "options": {
          "retry": {
            "enabled": true,
            "attempts": 5,
            "wait": 30000,
            "continueOnFail": false
          }
        }
      }
    },
    {
      "id": "c1b2c3d4-0001-4000-8000-000000000009",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1320,
        400
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, classification: $('Code: Classify Document').first().json.classification } }}"
      }
    }
  ],
