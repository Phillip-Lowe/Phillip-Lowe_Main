{
  "name": "SAOS VPS Ready Notification",
  "active": true,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "71b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook: VPS Ready",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [0, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "saos-vps-ready",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "saos-vps-ready-v2"
    },
    {
      "id": "71b2c3d4-0001-4000-8000-000000000002",
      "name": "Code: Build Provisioning Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "parameters": {
        "jsCode": "const payload = $input.first().json.body || $input.first().json;\nconst provisioningPayload = {\n  client_id: payload.client_id,\n  vps_id: payload.vps_id,\n  ip_address: payload.ip_address,\n  tailscale_ip: payload.tailscale_ip,\n  provider: payload.provider,\n  deploy_n8n: true,\n  deploy_agents: true,\n  agent_count: 10,\n  timestamp: new Date().toISOString()\n};\nreturn [{ json: { ...payload, provisioning: provisioningPayload } }];"
      }
    },
    {
      "id": "71b2c3d4-0001-4000-8000-000000000003",
      "name": "HTTP: Trigger Provisioning",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [440, 0],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8768/api/internal/workflows",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { client_id: $json.provisioning.client_id, workflow_name: 'VPS Ready Provisioning', service_type: 'provisioning', status: 'deployed', webhook_url: 'http://localhost:8768/api/internal/workflows/' + $json.provisioning.client_id + '/notify', test_payload: $json.provisioning } }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Api-Key", "value": "={{$env.SAOS_INTERNAL_API_KEY}}" }
          ]
        },
        "options": {
          "retry": {
            "enabled": true,
            "attempts": 5,
            "wait": 30000,
            "continueOnFail": false
          }
        }
      }
    },
    {
      "id": "71b2c3d4-0001-4000-8000-000000000004",
      "name": "Postgres: Update Infrastructure",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [660, 0],
      "parameters": {
        "credentialId": "postgres_saos",
        "database": "systack_memory",
        "schema": "public",
        "operation": "executeQuery",
        "query": "UPDATE client_infrastructure SET vps_id=$1, ip_address=$2, tailscale_ip=$3, provider=$4, updated_at=NOW() WHERE client_id=$5",
        "queryParameters": "={{[$('Code: Build Provisioning Payload').first().json.vps_id, $('Code: Build Provisioning Payload').first().json.ip_address, $('Code: Build Provisioning Payload').first().json.tailscale_ip, $('Code: Build Provisioning Payload').first().json.provider, $('Code: Build Provisioning Payload').first().json.client_id]}}"
      }
    },
    {
      "id": "71b2c3d4-0001-4000-8000-000000000005",
      "name": "HTTP: Notify Dashboard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [880, 0],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8768/api/internal/notify-client",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { client_id: $('Code: Build Provisioning Payload').first().json.client_id, message: 'VPS ready for client ' + $('Code: Build Provisioning Payload').first().json.client_id, urgency: 'normal', channel: 'dashboard' } }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Api-Key", "value": "={{$env.SAOS_INTERNAL_API_KEY}}" }
          ]
        },
        "options": {
          "retry": {
            "enabled": true,
            "attempts": 5,
            "wait": 30000,
            "continueOnFail": false
          }
        }
      }
    },
    {
      "id": "71b2c3d4-0001-4000-8000-000000000006",
      "name": "Email: Notify Phillip",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [1100, 0],
      "parameters": {
        "fromEmail": "phillip@systack.net",
        "toEmail": "phillip@systack.net",
        "subject": "New VPS Provisioned",
        "emailFormat": "html",
        "html": "={{'<h2>🚀 New VPS Provisioned</h2><table style=\"border-collapse:collapse;width:100%;\"><tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Client ID</b></td><td style=\"padding:8px;border:1px solid #ddd;\">' + $('Code: Build Provisioning Payload').first().json.client_id + '</td></tr><tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>VPS ID</b></td><td style=\"padding:8px;border:1px solid #ddd;\">' + $('Code: Build Provisioning Payload').first().json.vps_id + '</td></tr><tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>IP Address</b></td><td style=\"padding:8px;border:1px solid #ddd;\">' + $('Code: Build Provisioning Payload').first().json.ip_address + '</td></tr><tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Tailscale IP</b></td><td style=\"padding:8px;border:1px solid #ddd;\">' + $('Code: Build Provisioning Payload').first().json.tailscale_ip + '</td></tr><tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Provider</b></td><td style=\"padding:8px;border:1px solid #ddd;\">' + $('Code: Build Provisioning Payload').first().json.provider + '</td></tr><tr><td style=\"padding:8px;border:1px solid #ddd;\"><b>Status</b></td><td style=\"padding:8px;border:1px solid #ddd;\">Provisioning Started</td></tr></table><p style=\"color:#888;font-size:12px;\">SAOS Platform — Automated Notification</p>'}}",
        "options": {
          "host": "smtp.gmail.com",
          "port": 587,
          "user": "phillip@systack.net",
          "password": "={{$env.SMTP_PASSWORD}}"
        }
      }
    },
    {
      "id": "71b2c3d4-0001-4000-8000-000000000007",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1320, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, client_id: $('Code: Build Provisioning Payload').first().json.client_id, vps_id: $('Code: Build Provisioning Payload').first().json.vps_id, status: 'provisioning_started' } }}"
      }
    }
  ],
  "connections": {
    "Webhook: VPS Ready": {
      "main": [
        [
          { "node": "Code: Build Provisioning Payload", "type": "main", "index": 0 }
        ]
      ]
    },
    "Code: Build Provisioning Payload": {
      "main": [
        [
          { "node": "HTTP: Trigger Provisioning", "type": "main", "index": 0 }
        ]
      ]
    },
    "HTTP: Trigger Provisioning": {
      "main": [
        [
          { "node": "Postgres: Update Infrastructure", "type": "main", "index": 0 }
        ]
      ]
    },
    "Postgres: Update Infrastructure": {
      "main": [
        [
          { "node": "HTTP: Notify Dashboard", "type": "main", "index": 0 }
        ]
      ]
    },
    "HTTP: Notify Dashboard": {
      "main": [
        [
          { "node": "Email: Notify Phillip", "type": "main", "index": 0 }
        ]
      ]
    },
    "Email: Notify Phillip": {
      "main": [
        [
          { "node": "Respond to Webhook", "type": "main", "index": 0 }
        ]
      ]
    }
  }
}